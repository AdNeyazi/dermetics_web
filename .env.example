# =============================================================================
# DERMATICS Frontend (React + Vite)
# =============================================================================
# Development:
# Leave VITE_API_URL empty so requests to /api are proxied by Vite to Rails (http://localhost:3001)
# Same-origin proxy means zero CORS issues and cookies work automatically.
VITE_API_URL=

# Production (choose one strategy):
# Strategy A (Same Domain / Reverse Proxy - Recommended):
# Leave VITE_API_URL empty. Requests to /api are sent to the same host, avoiding CORS and 3rd-party cookie issues.
VITE_API_URL=

# Strategy B (Subdomain setup e.g. https://api.dermatics.com):
# VITE_API_URL=https://api.dermatics.com

# Strategy C (Cross-host deployment):
# VITE_API_URL=https://your-api.onrender.com

# =============================================================================
# Google Analytics 4 (GA4)
# =============================================================================
# Set your GA4 Measurement ID (format: G-XXXXXXXXXX)
# When set, pageviews, e-commerce funnels, traffic attribution, and Core Web Vitals are tracked.
# Leave blank during local testing to log events to the console instead.
VITE_GA_MEASUREMENT_ID=
